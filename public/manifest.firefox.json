{
  "manifest_version": 3,
  "name": "Aiki³",
  "description": "Aiki³ browser extension",
  "version": "3.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "aiki1@extension.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteActivity"]
      }
    }
  },
  "icons": {
    "128": "images/AikiLogo-128.png"
  },
  "permissions": ["storage", "tabs", "webNavigation"],
  "background": {
    "scripts": ["build/background.js"]
  },
  "action": {
    "default_title": "Aiki",
    "default_popup": "index.html?page=popup",
    "default_icon": "images/AikiLogo-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["build/injection.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/AikiLogo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "options_page": "index.html?page=settings"
}
